// Static assets only: no Worker script, no adapter. Workers Builds runs
// `pnpm build` and then `npx wrangler deploy`, which uploads ./dist.
{
  "name": "quoin-site",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
