---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import Hero from "~/components/sections/Hero.astro";
import Importing from "~/components/sections/Importing.astro";
import Tax from "~/components/sections/Tax.astro";
import Privacy from "~/components/sections/Privacy.astro";
import Desktop from "~/components/sections/Desktop.astro";
import Download from "~/components/sections/Download.astro";
import Faq from "~/components/sections/Faq.astro";
import Beta from "~/components/sections/Beta.astro";
import { BETA_GROUP } from "~/lib/links";
import { localeStaticPaths, useTranslations, type Locale } from "~/i18n";

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path=""
  title={t.meta.title}
  description={t.meta.description}
>
  <SiteHeader lang={lang} />
  <main id="content">
    <Hero lang={lang} />
    <Importing lang={lang} />
    <Tax lang={lang} />
    <Privacy lang={lang} />
    <Desktop lang={lang} />
    <Download lang={lang} />
    <Faq lang={lang} />
    {BETA_GROUP && <Beta lang={lang} href={BETA_GROUP} />}
  </main>
  <SiteFooter lang={lang} path="" />
</BaseLayout>
