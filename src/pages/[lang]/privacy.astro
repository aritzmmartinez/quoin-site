---
import { getEntry, render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import { localeStaticPaths, useTranslations, type Locale } from "~/i18n";

export const getStaticPaths = localeStaticPaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const entry = await getEntry("privacy", lang);
if (!entry) throw new Error(`Missing privacy policy for ${lang}`);
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const updated = new Intl.DateTimeFormat(t.numberLocale, {
  dateStyle: "long",
  timeZone: "UTC",
}).format(entry.data.updated);
---

<BaseLayout
  lang={lang}
  path="/privacy"
  title={t.privacyPage.title}
  description={t.privacyPage.description}
>
  <SiteHeader lang={lang} variant="page" />
  <main id="content" class="mx-auto max-w-300 px-6 pt-12 sm:pt-18">
    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4 border-b border-text pb-8">
      <h1 class="m-0 text-[clamp(44px,6.6vw,88px)] leading-[0.98] font-semibold tracking-[-0.045em]">
        {t.privacyPage.heading}
      </h1>
      <p class="m-0 text-sm text-muted">
        {t.privacyPage.updated}{" "}
        <time datetime={entry.data.updated.toISOString().slice(0, 10)}>
          {updated}
        </time>
      </p>
    </div>
    <div class="flex flex-wrap gap-x-24">
      <nav
        aria-label={t.privacyPage.toc}
        class="min-w-0 flex-[3_1_220px] pt-14"
      >
        <ol class="m-0 flex list-none flex-col gap-2.5 p-0 text-sm lg:sticky lg:top-24">
          {toc.map((h, i) => (
            <li>
              <a
                class="text-muted no-underline transition-colors hover:text-text"
                href={`#${h.slug}`}
              >
                {i + 1}. {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="min-w-0 max-w-180 flex-[7_1_560px]">
        <p class="m-0 pt-14 text-[clamp(22px,2.4vw,28px)] leading-[1.35] font-medium tracking-[-0.02em]">
          {entry.data.summary}{" "}
          <span class="text-muted">{entry.data.summaryMuted}</span>
        </p>
        <article class="policy">
          <Content />
        </article>
      </div>
    </div>
  </main>
  <SiteFooter lang={lang} path="/privacy" variant="page" />
</BaseLayout>
