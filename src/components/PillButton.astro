---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  variant?: "primary" | "secondary";
  size?: "md" | "lg";
}

const { variant = "primary", size = "md", class: extra, ...rest } = Astro.props;
---

<a
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full font-semibold no-underline transition-opacity hover:opacity-85",
    size === "lg" ? "min-h-12.5 px-6 text-[15px]" : "min-h-10 px-4 text-sm",
    variant === "primary"
      ? "bg-accent text-on-accent"
      : "border border-border text-text",
    extra,
  ]}
  {...rest}
>
  <slot />
</a>
