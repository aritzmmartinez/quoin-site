---
import Logo from "./Logo.astro";
import PillButton from "./PillButton.astro";
import FloatingNav from "~/islands/FloatingNav";
import ThemeToggle from "~/islands/ThemeToggle";
import { useTranslations, type Locale } from "~/i18n";
import { links } from "~/lib/links";

interface Props {
  lang: Locale;
  variant?: "landing" | "page";
}

const { lang, variant = "landing" } = Astro.props;
const t = useTranslations(lang);
const home = `/${lang}`;
const sections = [
  ["#import", t.nav.how],
  ["#privacy", t.nav.privacy],
  ["#download", t.nav.download],
  ["#faq", t.nav.faq],
] as const;
---

<a
  href="#content"
  class="fixed top-3 left-3 z-50 -translate-y-24 rounded-full bg-accent px-4 py-2 text-sm font-semibold text-on-accent no-underline focus:translate-y-0"
>
  {t.a11y.skip}
</a>
<header class="sticky top-0 z-30 px-4 pt-3">
  <FloatingNav client:load>
    <nav
      aria-label={t.a11y.mainNav}
      class="flex h-14 items-center justify-between gap-4 pr-2 pl-4.5"
    >
      <a
        href={home}
        class="flex items-center gap-2.5 text-text no-underline"
        aria-label={t.a11y.home}
      >
        <Logo />
        <span class="text-base font-semibold" aria-hidden="true">
          Quoin
        </span>
      </a>
      {variant === "landing" && (
        <ul class="m-0 hidden list-none gap-0.5 p-0 text-sm md:flex">
          {sections.map(([href, label]) => (
            <li>
              <a
                class="rounded-full px-3 py-2 text-muted no-underline transition-colors hover:text-text"
                href={href}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      )}
      <div class="flex items-center gap-1">
        <ThemeToggle client:load labels={t.theme} />
        {variant === "landing" && (
          <a
            href={links.repo}
            aria-label={t.a11y.github}
            class="hidden size-10 items-center justify-center rounded-full text-muted transition-colors hover:text-text sm:inline-flex"
          >
            <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
              ></path>
            </svg>
          </a>
        )}
        {variant === "landing" ? (
          <PillButton href="#download" class="hidden min-[480px]:inline-flex">
            {t.nav.cta}
          </PillButton>
        ) : (
          <a class="link px-3 text-sm" href={home}>
            {t.privacyPage.back}
          </a>
        )}
      </div>
    </nav>
  </FloatingNav>
</header>
