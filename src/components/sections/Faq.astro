---
import Section from "../Section.astro";
import Rich from "../Rich.astro";
import { useTranslations, type Locale } from "~/i18n";
import { BETA_GROUP, links } from "~/lib/links";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="faq" title={t.faq.title}>
  <div class="border-t border-border">
    {t.faq.items.map((item) => (
      <details class="group border-b border-border">
        <summary class="flex min-h-[60px] cursor-pointer list-none items-center justify-between gap-4 py-3.5 text-[17px] font-medium [&::-webkit-details-marker]:hidden">
          {item.q}
          <svg
            width="14"
            height="14"
            viewBox="0 0 16 16"
            aria-hidden="true"
            class="shrink-0 text-muted transition-transform duration-200 group-open:rotate-45"
          >
            <path
              d="M8 3v10M3 8h10"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
        </summary>
        <p class="mt-0 mb-5 max-w-[640px] text-[15px] leading-relaxed text-body">
          {BETA_GROUP && "aOpen" in item ? (
            <Rich parts={item.aOpen} href={BETA_GROUP} />
          ) : (
            <Rich parts={item.a} href={links.newIssue} />
          )}
        </p>
      </details>
    ))}
  </div>
</Section>
