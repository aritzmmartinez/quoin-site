---
interface Props {
  tone?: "neutral" | "positive";
}
const { tone = "neutral" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 self-start rounded-full border border-border px-2.5 py-1 text-xs leading-none font-medium whitespace-nowrap",
    tone === "positive" ? "text-text" : "text-muted",
  ]}
>
  {tone === "positive" && (
    <span aria-hidden="true" class="size-1.5 rounded-full bg-positive" />
  )}
  <slot />
</span>
