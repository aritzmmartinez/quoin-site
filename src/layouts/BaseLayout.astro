---
import "~/styles/global.css";
import { THEME_SCRIPT } from "~/lib/theme";
import { defaultLocale, locales, useTranslations, type Locale } from "~/i18n";

interface Props {
  lang: Locale;
  path: string;
  title: string;
  description: string;
}

const { lang, path, title, description } = Astro.props;
const urlFor = (l: Locale) => new URL(`/${l}${path}`, Astro.site).href;
const t = useTranslations(lang);
const ogLocale = (l: Locale) => (l === "es" ? "es_ES" : "en_GB");
const ogImage = new URL(`/og/${lang}.png`, Astro.site).href;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={THEME_SCRIPT} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={urlFor(lang)} />
    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={urlFor(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={urlFor(defaultLocale)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quoin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlFor(lang)} />
    <meta property="og:locale" content={ogLocale(lang)} />
    {locales
      .filter((l) => l !== lang)
      .map((l) => (
        <meta property="og:locale:alternate" content={ogLocale(l)} />
      ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-bg text-text">
    <slot />
  </body>
</html>
